APP_NAME=PerroniPhone
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=perroniphone_db
DB_USERNAME=perroniphone_user
DB_PASSWORD=perroniphone_pass

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- JWT (autenticación de la API, equivalente al Jwt:Key de appsettings.json) ---
JWT_SECRET=
JWT_TTL=20

# --- CORS: mismo propósito que Cors:OrigenesPermitidos en appsettings.json ---
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
