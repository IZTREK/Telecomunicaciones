APP_NAME=PerroniPhone
APP_ENV=local
# Se genera sola al arrancar el contenedor (docker/entrypoint.sh).
APP_KEY=
# false: un error 500 responde un mensaje genérico, sin stack trace ni rutas
# internas. Ponlo en true SOLO en tu máquina para depurar.
APP_DEBUG=false
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Los valores reales los inyecta docker-compose.yml al arrancar.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=perroniphone_db
DB_USERNAME=perroniphone_user
DB_PASSWORD=perroniphone_pass

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- JWT: la llave se genera sola al arrancar el contenedor ---
JWT_SECRET=
JWT_TTL=20

# --- CORS: vacío porque frontend y API comparten origen (ver config/cors.php) ---
FRONTEND_ORIGINS=
